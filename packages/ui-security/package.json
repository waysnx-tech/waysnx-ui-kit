{
  "name": "@waysnx/ui-security",
  "version": "1.0.0",
  "description": "Enterprise-grade security components from WaysNX - authentication, authorization, MFA, secure inputs, and session management",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LLM.md"],
  "keywords": ["react", "security", "authentication", "authorization", "mfa", "session", "waysnx"],
  "author": "WaysNX Technologies",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@waysnx/ui-core": "workspace:*",
    "@waysnx/ui-feedback": "workspace:*",
    "@waysnx/ui-i18n": "workspace:*",
    "@waysnx/ui-layout": "workspace:*",
    "@waysnx/ui-media": "workspace:*",
    "dompurify": "^3.3.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "^2.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup && npm run copy-css",
    "copy-css": "copyfiles -u 1 \"src/**/*.css\" dist",
    "clean": "rm -rf dist",
    "test:totp": "node --experimental-strip-types scripts/totp.regression.mjs"
  },
  "exports": {
    "./dist/index.css": "./dist/index.css",
    "./dist/styles/index.css": "./dist/styles/index.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": ["*.css"],
  "repository": { "type": "git", "url": "https://github.com/waysnx/waysnx-ui-kit", "directory": "packages/ui-security" }
}
