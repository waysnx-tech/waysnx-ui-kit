{
  "name": "@waysnx/ui-layout",
  "version": "1.0.0",
  "description": "Comprehensive layout components from WaysNX - page structure, layout utilities, content organization, and navigation",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LLM.md"],
  "keywords": ["react", "ui", "layout", "sidebar", "page", "grid", "tabs", "accordion", "breadcrumb", "stepper", "card", "panel", "waysnx"],
  "author": "WaysNX Technologies",
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@waysnx/ui-i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "copyfiles": "^2.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup && npm run copy-css",
    "copy-css": "copyfiles -u 1 \"src/**/*.css\" dist",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./dist/index.css": "./dist/index.css",
    "./dist/styles/index.css": "./dist/styles/index.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": ["*.css"],
  "repository": { "type": "git", "url": "https://github.com/waysnx/waysnx-ui-kit", "directory": "packages/ui-layout" }
}
