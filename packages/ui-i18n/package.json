{
  "name": "@waysnx/ui-i18n",
  "version": "1.0.0",
  "description": "Internationalization (i18n) provider for WaysNX UI Kit - shared translation context across all packages",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LLM.md"],
  "keywords": ["react", "i18n", "internationalization", "translations", "waysnx"],
  "author": "WaysNX Technologies",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/waysnx/waysnx-ui-kit", "directory": "packages/ui-i18n" }
}
