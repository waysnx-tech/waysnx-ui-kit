{
  "name": "@waysnx/ui-form-builder",
  "version": "1.0.0",
  "description": "Schema-driven form builder from WaysNX - renders forms from JSON Schema using ui-core components",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LLM.md"
  ],
  "keywords": [
    "react",
    "ui",
    "form-builder",
    "json-schema",
    "dynamic-forms",
    "waysnx"
  ],
  "author": "WaysNX Technologies",
  "peerDependencies": {
    "@waysnx/ui-core": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "exports": {
    "./dist/index.css": "./dist/index.css",
    "./dist/styles/index.css": "./dist/styles/index.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/waysnx/waysnx-ui-kit",
    "directory": "packages/ui-form-builder"
  }
}
