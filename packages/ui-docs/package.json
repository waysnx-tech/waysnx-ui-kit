{
  "name": "@waysnx/ui-docs",
  "version": "1.0.0",
  "description": "Enterprise-grade documentation framework for rendering documentation entirely from structured metadata — JSON driven, component based, and completely generic",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LLM.md"],
  "keywords": ["react", "documentation", "docs", "markdown", "component-library", "design-system", "waysnx", "metadata-driven", "enterprise"],
  "author": "WaysNX Technologies",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@waysnx/ui-i18n": "workspace:*",
    "prismjs": "^1.29.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.11",
    "copyfiles": "^2.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup && npm run copy-css",
    "copy-css": "copyfiles -u 1 \"src/**/*.css\" dist",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/waysnx/waysnx-ui-kit", "directory": "packages/ui-docs" }
}
